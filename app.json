{
  "expo": {
    "name": "Happy Orange",
    "slug": "project-heal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.happyorange.heal"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.happyorange.heal"
    },
    "web": {
      "name": "Happy Orange",
      "shortName": "Happy Orange",
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Happy Orange uses your photos to estimate the nutrition of your meals.",
          "cameraPermission": "Happy Orange uses the camera to photograph your meals and estimate their nutrition.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "projectheal",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "healmyra",
    "extra": {
      "eas": {
        "projectId": "354c8819-fcf8-4359-8165-35e3738f2dc8"
      }
    }
  }
}
